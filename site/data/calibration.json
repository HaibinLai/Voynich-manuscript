  "metric_definition": "按密文中每次字母出现加权的字母对应准确率；仅普通替换等同原序字符恢复。",
  "findings": [
    {
      "claim": "普通一一替换可恢复",
      "evidence": "两个语言各3个不重叠测试片段，正确语言顺序模型均恢复100%已出现字符。",
      "scope": "同一本书内不重叠片段，保留词界，单一26字母置换。"
    },
    {
      "claim": "本次乱序密文需要匹配的评分",
      "evidence": "词袋模型恢复全部6个窗口的字母对应；顺序模型在排序密文上仅恢复3.98%–35.40%。",
      "scope": "词袋不包含词内顺序，不能直接称为原句恢复。"
    },
    {
      "claim": "高恢复率不等于识别语言",
      "evidence": "英文顺序模型对拉丁替换仍恢复96.43%–100%字符对应。",
      "scope": "仅两个共享字母表的语言样本，不是语言鉴定基准。"
    },
    {
      "claim": "优化错误目标会错得更自信",
      "evidence": "排序、乱序、全局打乱例中，错误密钥均可获得高于真密钥的顺序模型评分。",
      "scope": "搜索多跑不能修复评分模型与生成机制不匹配。"
    }
  ],
  "limits": [
    "仅英文 Alice 与拉丁 Caesar 两本书",
    "训练、开发、测试不重叠，但属于同书",
    "真值只在合成实验中可用",
    "未对真实手稿输出任何译文"
  ],
